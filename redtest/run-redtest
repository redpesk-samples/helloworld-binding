#!/bin/bash
set -euo pipefail
set -x

PACKAGE_NAME="helloworld-binding"
COVERAGE=no

echo "--- Start test python hello world binding ---"

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
PROJECT_ROOT=$(cd -- "${SCRIPT_DIR}/.." &>/dev/null && pwd)

COVERAGE_DIR="${SCRIPT_DIR}/coverage_data"
BUILD_DIR="${PROJECT_ROOT}/build"
INSTALLED_LIB_DIR="/usr/redpesk/${PACKAGE_NAME}/lib"

if [[ "${COVERAGE}" == "yes" ]]; then
    # Prepare coverage output directory.
    mkdir -p "${COVERAGE_DIR}"

    # Clean previous runtime coverage data only.
    find "${COVERAGE_DIR}" -name '*.gcda' -delete 2>/dev/null || true

    export GCOV_PREFIX="${COVERAGE_DIR}/"
    export GCOV_PREFIX_STRIP=5
fi

# Build LD_LIBRARY_PATH dynamically.
LIB_PATHS=()
if [[ -d "${INSTALLED_LIB_DIR}" ]]; then
    LIB_PATHS+=("${INSTALLED_LIB_DIR}")
fi
if [[ -d "${BUILD_DIR}" ]]; then
    LIB_PATHS+=("${BUILD_DIR}")
fi

if [[ ${#LIB_PATHS[@]} -eq 0 ]]; then
    echo "ERROR: no library path found for ${PACKAGE_NAME}" >&2
    exit 1
fi

LD_LIBRARY_PATH_VALUE="$(
    IFS=:
    echo "${LIB_PATHS[*]}"
)"
if [[ -n "${LD_LIBRARY_PATH:-}" ]]; then
    LD_LIBRARY_PATH_VALUE="${LD_LIBRARY_PATH_VALUE}:${LD_LIBRARY_PATH}"
fi
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH_VALUE}"

# Create the directory where logs need to be written.
LOG_DIR="${LOG_DIR:-/var/log/redtest/${PACKAGE_NAME}}"
if ! mkdir -p "${LOG_DIR}" 2>/dev/null || [[ ! -w "${LOG_DIR}" ]]; then
    LOG_DIR="${PROJECT_ROOT}/logs"
    mkdir -p "${LOG_DIR}"
fi
export LOG_DIR

python3 "${SCRIPT_DIR}/tests.py" --tap | tee "${LOG_DIR}/helloworld.tap" 2>&1

GCOV_LOG_DIR="${LOG_DIR}"
find "${GCOV_LOG_DIR}" -maxdepth 1 -type f \( -name '*.gcno' -o -name '*.gcda' \) \
    -delete 2>/dev/null || true

GCNO_COUNT=0
GCDA_COUNT=0

if [[ -d "${COVERAGE_DIR}" ]]; then
    while IFS= read -r -d '' gcno; do
        install -Dm0644 "${gcno}" "${GCOV_LOG_DIR}/$(basename "${gcno}")"
        ((GCNO_COUNT += 1))
    done < <(find "${COVERAGE_DIR}" -type f -name '*.gcno' -print0)

    while IFS= read -r -d '' gcda; do
        install -Dm0644 "${gcda}" "${GCOV_LOG_DIR}/$(basename "${gcda}")"
        ((GCDA_COUNT += 1))
    done < <(find "${COVERAGE_DIR}" -type f -name '*.gcda' -print0)
fi

if [[ ${GCNO_COUNT} -gt 0 || ${GCDA_COUNT} -gt 0 ]]; then
    echo "--- Exported ${GCNO_COUNT} .gcno and ${GCDA_COUNT} .gcda file(s) to ${GCOV_LOG_DIR} ---"
    ls -l "${GCOV_LOG_DIR}"/*.gcno "${GCOV_LOG_DIR}"/*.gcda 2>/dev/null || true
else
    echo "--- No gcov data found to export ---"
fi

##########################
# Coverage report section
##########################

if [[ "${COVERAGE}" == "yes" ]]; then
    echo "--- Generating gcov coverage summary ---"

    command -v gcov >/dev/null 2>&1 || {
        echo "ERROR: gcov is required when coverage is enabled" >&2
        exit 1
    }

    mapfile -d '' GCNO_FILES < <(
        find "${COVERAGE_DIR}" -type f \
            -path '*/CMakeFiles/helloworld-binding.dir/*' \
            -name '*.gcno' \
            -print0 | sort -z
    )

    if [[ ${#GCNO_FILES[@]} -eq 0 ]]; then
        echo "ERROR: no helloworld-binding .gcno files found in ${COVERAGE_DIR}" >&2
        exit 1
    fi

    "${SCRIPT_DIR}/gcov-total.sh" "${GCNO_FILES[@]}" |
        tee "${LOG_DIR}/coverage.log"

fi

##########################
# Report status
##########################
test -f "${LOG_DIR}/helloworld.tap" && grep -viq '^not ok' "${LOG_DIR}/helloworld.tap"
